    "devtools"
  ],
  "author": "gbit",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "preferGlobal": true,
  "dependencies": {}
}
